<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      <%= link_to "← Retour aux listes", lists_path,
          class: "text-secondary text-decoration-none small" %>

      <div class="mt-4 mb-4">
        <p class="text-secondary mb-2">Collection</p>
        <h1 class="h2 mb-0">Créer une liste</h1>
      </div>

      <%= simple_form_for @list do |f| %>
       <%= f.input :name, label: "Nom de la liste", placeholder: "Ex. : Films à revoir", input_html: {
          class: "form-control-lg",
          autofocus: true
      } %>

      <%= f.button :submit, "Créer la liste", class: "btn btn-dark" %>
      <% end %>
    </div>
  </div>
</div>

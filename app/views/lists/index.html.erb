<div class="container py-5">
  <header class="mb-5">
    <p class="text-secondary mb-2">Collection</p>
    <div class="d-flex justify-content-between align-items-center gap-3">
      <h1 class="h2 mb-0">Listes de films</h1>
      <%= link_to "＋ Nouvelle liste", new_list_path,
          class: "btn btn-dark rounded-2" %>
    </div>
  </header>

  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
    <% @lists.each do |list| %>
      <div class="col">
        <%= link_to list_path(list),
            class: "card h-100 text-decoration-none text-dark border rounded-3 shadow-sm list-card" do %>
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start">
              <h2 class="h5 mb-3"><%= list.name %></h2>
              <span class="text-secondary small">
                <%= list.bookmarks.size %> films
              </span>
            </div>
            <span class="small text-secondary">Voir la liste →</span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

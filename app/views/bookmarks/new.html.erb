<div class="container py-5">
  <h1 class="h3 mb-4">Ajouter un film à la liste</h1>

  <%= simple_form_for [@bookmark.list, @bookmark] do |f| %>
    <%= f.association :movie,
        collection: Movie.order(:title),
        label: "Film",
        prompt: "Choisir un film",
        label_method: :title %>

    <%= f.input :comment, label: "Commentaire" %>

    <%= f.button :submit, "Ajouter le film", class: "btn btn-dark" %>
  <% end %>
</div>
